PORT=4000
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

DATABASE_URL="postgresql://parsemycas:parsemycas@localhost:5432/parsemycas_db"

# Nivesh Star's central account system (app2.mfapis.club — the same backend that
# serves /cas/ai/parse). This app has no login/signup of its own anymore — accounts
# are shared across all Nivesh Star products. Used here only to validate an
# investor's session (GET /investor) before letting them upload/view statements.
NIVESH_STAR_API_BASE_URL="https://app2.mfapis.club/api/v2"

# CAS parsing API — calls are authenticated with the logged-in investor's own
# accessToken (forwarded from the frontend), not a separate partner login.
CAS_API_URL="https://app2.mfapis.club/api/v2/cas/ai/parse"

# Set to "true" to skip the real API and return the bundled sample fixture instead
# (useful for local UI work without a live investor session).
MOCK_CAS_PARSE=false
