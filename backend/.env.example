PORT=4000
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

DATABASE_URL="postgresql://parsemycas:parsemycas@localhost:5432/parsemycas_db"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="30d"

# Email (Resend — https://resend.com). Leave RESEND_API_KEY unset to skip sending
# real emails (verification codes are just logged to the console instead).
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Google sign-in (https://console.cloud.google.com/apis/credentials). Leave both
# unset to disable the "Sign in with Google" button (it'll show a clear error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# CAS parsing API (https://app2.mfapis.club)
# Leave PARTNER_IDENTIFIER/PARTNER_PASSWORD empty/unset to run in MOCK MODE
# (returns the bundled sample fixture for every upload instead of calling the real API).
PARTNER_IDENTIFIER=
PARTNER_PASSWORD=
PARTNER_LOGIN_URL="https://app2.mfapis.club/api/v2/partner/login"
CAS_API_URL="https://app2.mfapis.club/api/v2/cas/ai/parse"
