VITE_API_URL=http://localhost:4000/api

# Nivesh Star's central account system — signup/login/OTP calls go straight from
# the browser to this API (same one that serves /cas/ai/parse), not through our
# own backend. See frontend/src/lib/niveshStar.js.
VITE_NIVESH_STAR_API_BASE_URL=https://app2.mfapis.club/api/v2

# Google Identity Services client ID (console.cloud.google.com/apis/credentials).
# Needs "http://localhost:5173" added under Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
